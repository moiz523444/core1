PORT=5000
# Email Configuration
# You can use your own SMTP server like Gmail, Sendgrid, AWS SES, or Hostinger.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Core 1 Studio <your-email@gmail.com>

# Target email where you want to receive leads
RECEIVER_EMAIL=your-owner-email@gmail.com
